# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Maximum accepted upload size in bytes (default 10 MiB, hard cap 50 MiB)
MAX_UPLOAD_BYTES=10485760
REQUEST_TIMEOUT_MS=30000
API_DOCS_ENABLED=true

# --- Adapter selection -------------------------------------------------------
# Defaults run fully locally with no AWS access:
#   STORAGE_DRIVER=memory   EXTRACTOR_DRIVER=stub
# AWS mode (textract requires s3):
#   STORAGE_DRIVER=s3       EXTRACTOR_DRIVER=textract
STORAGE_DRIVER=memory
EXTRACTOR_DRIVER=stub

# --- AWS (only read when an AWS adapter is enabled) --------------------------
# Credentials are NOT configured here. The AWS SDK default credential chain is
# used: AWS_PROFILE / SSO locally, an IAM role when deployed.
# AWS_REGION=eu-west-2
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_KMS_KEY_ID=            # optional; otherwise the bucket default encryption applies
# AWS_MAX_ATTEMPTS=3            # SDK standard retry mode, total attempts per call
# AWS_CONNECTION_TIMEOUT_MS=3000
# AWS_REQUEST_TIMEOUT_MS=10000

# --- Asynchronous PDF OCR completion tracking ---------------------------------
# TEXTRACT_POLL_INITIAL_DELAY_MS=2000
# TEXTRACT_POLL_MAX_DELAY_MS=15000
# TEXTRACT_JOB_TIMEOUT_MS=300000   # then FAILED ("Text extraction timed out"), retryable
# TEXTRACT_MAX_RESULT_PAGES=100    # GetDocumentTextDetection result pages per job
# TEXTRACT_MAX_PENDING_JOBS=50     # beyond this, /process returns 503
